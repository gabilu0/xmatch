# --- API ---
# Local: aponta para o backend rodando via npm run start:dev
# Produção: aponta para a URL publicada da API
VITE_API_URL=http://localhost:3000

# --- Firebase Web / Cloud Messaging ---
# Copie os valores do app Web no Firebase Console para o .env local e para
# as variáveis de ambiente do deploy. Não versione o arquivo .env real.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
